par(0).
par(N) :- 
    N >= 2, 
    N1 is N - 2,
    par(N1).
par(N) :- 
    N < 0,   
    M is -N,
    par(M).

EJERCICIO 2
sumaP(0, 0).
sumaP(N, S) :- 
    N > 0, 
    N1 is N - 1,
    suma(N1, S1).
    S is S1 + 2 * N.
suma(N, S) :- sumaP(N, S).

EJERCICIO 3
potencia(_, 0, 1).
potencia(B, E, V) :-
    int(E),
    E > 0,
    E1 is -E,
    potencia(B, E1, V1),
    V is V1 * B.

EJERCICIO 4

fibonacci(0, 0).
fibonacci(1 , 1).
fibonacci(N, R) :- 
    N > 1,
    N1 is N - 1,
    N2 is N - 2, 
    fibonacci(N1, R1),
    fibonacci(N2, R2),
    R is R1 + R2.

