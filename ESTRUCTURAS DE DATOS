%Definir la relación casado con teléfono. 
casado_con_tel(X, Y, Tel) :- 
    casado(X, Y), 
    persona(Y, Tel, _, _).

%Mostrar los casados
mostrar_casados :- 
    forall((casado(X, Y), X @< Y), (write(X-Y), nl)).

%Indicar para sirve: c(X) if casado(X, Y), visita(Y, Z), persona(Z, _, m).
c(X) :- 
    casado(X, Y), 
    visita(Y, Z), 
    persona(Z, _, m, _).

