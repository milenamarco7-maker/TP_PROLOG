camino(O, D, Ruta, Dist) :-
    caminoAux(O, D, [O], RutaInv, Dist),
    reverse(RutaInv, Ruta).

caminoAux(D, D, Visitadas, Visitadas, 0).
caminoAux(O, D, Visitadas, Ruta, Dist) :-
    ruta(O, X, Km),
    \+ member(X, Visitadas),
    caminoAux(X, D, [X|Visitadas], Ruta, Dist1),
    Dist is Km + Dist1.

existeCamino(O, D) :-
    (   once(camino(O, D, _, _))
    ->  format('Sí existe camino de ~w a ~w~n', [O, D])
    ;   format('No existe camino de ~w a ~w~n', [O, D])
    ).

distancia(O, D, Dist) :-
    camino(O, D, _, Dist).

distanciaMinima(O, D, Min) :-
    findall(Dist, camino(O, D, _, Dist), Distancias),
    Distancias \= [],
    min_list(Distancias, Min).

buscarCamino(O, D) :-
    write(O),
    buscarAux(O, D, [O]).
buscarCamino(O, D) :-
    \+ camino(O, D, _, _),
    nl,
    format('No hay camino de ~w a ~w~n', [O, D]),
    fail.

buscarAux(D, D, _) :-
    nl.
buscarAux(O, D, Visitadas) :-
    O \= D,
    ruta(O, X, _),
    \+ member(X, Visitadas),
    write(' -> '),
    write(X),
    buscarAux(X, D, [X|Visitadas]).
